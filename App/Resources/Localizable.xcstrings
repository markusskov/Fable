    "Stays on this device. Fable never sends or collects it, and there is no account, ever." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bleibt auf diesem Gerät. Fable sendet und sammelt es nie, und es gibt nie ein Konto."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se queda en este dispositivo. Fable nunca lo envía ni lo recopila, y nunca hay cuenta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reste sur cet appareil. Fable ne l'envoie ni ne le collecte jamais, et il n'y a jamais de compte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resta su questo dispositivo. Fable non lo invia né lo raccoglie mai, e non serve mai un account."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blir på denne enheten. Fable sender og samler det aldri inn, og det finnes aldri en konto."
