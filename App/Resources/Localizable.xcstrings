    "Stories can't use that word. Try a friendlier sidekick." : {
      "comment" : "Profile form: the companion field failed the content-safety check",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Wort können die Geschichten nicht verwenden. Versuch es mit einem freundlicheren Begleiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los cuentos no pueden usar esa palabra. Prueba con un acompañante más amable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les histoires ne peuvent pas utiliser ce mot. Essaie un compagnon plus amical."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le storie non possono usare quella parola. Prova con un compagno più amichevole."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Historiene kan ikke bruke det ordet. Prøv en vennligere følgesvenn."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As histórias não podem usar essa palavra. Tente um companheiro mais amigável."
          }
        }
      }
    },
    "Stories can't use that word. Try something cozier." : {
      "comment" : "Profile form: the comfort-object field failed the content-safety check",
      "localizations" : {
        "de" : {
