    "%@ has no stories yet. This can't be undone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat noch keine Geschichten. Das lässt sich nicht rückgängig machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ todavía no tiene historias. Esto no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n'a pas encore d'histoires. C'est définitif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non ha ancora storie. L'operazione non può essere annullata."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ har ingen historier ennå. Dette kan ikke angres."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ainda não tem histórias. Isso não pode ser desfeito."
          }
        }
      }
    },
    "%@, that's %@ a month" : {
      "comment" : "Yearly price line: full price, then its monthly equivalent",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, das sind %@ im Monat"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, son %@ al mes"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, soit %@ par mois"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, cioè %@ al mese"
          }
        },
