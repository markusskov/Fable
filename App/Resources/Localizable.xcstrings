    "Bedtime stories, written on this device. Fable never sends or collects your family's data." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gutenachtgeschichten, auf diesem Gerät geschrieben. Fable sendet und sammelt die Daten deiner Familie nie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuentos para dormir, escritos en este dispositivo. Fable nunca envía ni recopila los datos de tu familia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des histoires du soir, écrites sur cet appareil. Fable n'envoie ni ne collecte jamais les données de ta famille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Storie della buonanotte, scritte su questo dispositivo. Fable non invia né raccoglie mai i dati della tua famiglia."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
