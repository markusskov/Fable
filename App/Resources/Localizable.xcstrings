    "Your device may be out of storage. Freeing some space and reopening Fable usually fixes it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vielleicht ist der Speicher deines Geräts voll. Etwas Platz schaffen und Fable neu öffnen hilft meistens."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede que tu dispositivo se haya quedado sin espacio. Liberar algo de espacio y volver a abrir Fable suele solucionarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton appareil manque peut-être d'espace. Libérer un peu de place et rouvrir Fable règle souvent le problème."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo dispositivo potrebbe non avere più spazio. Liberare un po' di spazio e riaprire Fable di solito risolve."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enheten din kan være tom for lagringsplass. Å frigjøre litt plass og åpne Fable på nytt pleier å hjelpe."
          }
        },
        "pt-BR" : {
