    "Fable+ is active. Thank you for supporting a small, quiet app." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fable+ ist aktiv. Danke, dass du eine kleine, ruhige App unterstützt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fable+ está activo. Gracias por apoyar una app pequeña y tranquila."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fable+ est actif. Merci de soutenir une petite application paisible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fable+ è attivo. Grazie per sostenere una piccola app tranquilla."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fable+ er aktivt. Takk for at du støtter en liten, rolig app."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Fable+ está ativo. Obrigado por apoiar um app pequeno e tranquilo."
          }
        }
      }
    },
    "Fable+ makes story time unlimited, every single night." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Fable+ ist die Geschichtenzeit unbegrenzt, jeden einzelnen Abend."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con Fable+ la hora del cuento es ilimitada, todas las noches."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec Fable+, l'heure de l'histoire devient illimitée, chaque soir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con Fable+ l'ora della storia non finisce mai, ogni singola sera."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fable+ gjør eventyrstunden ubegrenset, hver eneste kveld."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com o Fable+, a hora da história não tem limite, toda santa noite."
          }
        }
      }
    },
